# ==============================================================================
# SECUREFLOW - Git Ignore Configuration
# ==============================================================================

# Environment & Secret Files (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example
*.env
*.env.local

# Certificates & Private Keys
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
certificates/
secrets/
certs/

# Dependencies
node_modules/
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*$py.class
.venv/
venv/
env/
ENV/

# Build & Distribution Artifacts
dist/
build/
*.egg-info/
.eggs/

# Testing & Coverage
coverage/
.coverage
htmlcov/
.pytest_cache/
.vitest/

# Logs & Runtime
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databases & Local Storage
*.sqlite
*.sqlite3
*.db

# IDE & Operating System
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl

# Docker
*.tar

