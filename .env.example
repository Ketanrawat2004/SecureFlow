# ==============================================================================
# SECUREFLOW - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as required for your environment.
# Never commit real production secrets to version control.

# Application Environment
ENVIRONMENT=development
APP_NAME=SecureFlow
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=secureflow-dev-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL - SQLite fallback for local test/dev without docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/secureflow
# SQLite fallback example: sqlite+aiosqlite:///./secureflow.db
# SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secureflow

# Redis (Caching & Rate Limiting)
REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Kafka (Domain Event Streaming)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=secureflow-backend
KAFKA_GROUP_ID=secureflow-consumers
KAFKA_ENABLED=true

# Authentication (OAuth 2.0 / OpenID Connect)
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# AWS Configuration (for Terraform / ECS Deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=

# Frontend Vite Public Config
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=SecureFlow
