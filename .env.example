# ==============================================================================
# SECUREFLOW - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the required values.
# NEVER commit .env or any file containing real credentials to Git.
#
# Production URL:   https://secureflow.duckdns.org
# Local Docker:     http://localhost:3000
# Local Dev Mode:   http://localhost:5173
# ==============================================================================


# ==============================================================================
# [A] FRONTEND PUBLIC CONFIGURATION (Vite)
# These variables are embedded into the client bundle at build time (VITE_ prefix).
# Never place private secrets in these variables.
# ==============================================================================

# API Base URL (leave empty for same-origin proxy in Docker/Nginx, or specify full URL)
# Local Docker / Nginx reverse proxy:  /api/v1  (or leave empty)
# Local standalone Vite dev server:     http://localhost:8000/api/v1
# Production deployment:               https://secureflow.duckdns.org/api/v1
VITE_API_BASE_URL=

# Application Display Title
VITE_APP_TITLE=SecureFlow


# ==============================================================================
# [B] BACKEND CORE & APPLICATION SETTINGS
# ==============================================================================

# Runtime environment: 'development', 'production', or 'testing'
ENVIRONMENT=production

# Application display name
APP_NAME=SecureFlow

# Debug mode (disable in production for security)
DEBUG=false

# Backend server host and port
HOST=0.0.0.0
PORT=8000

# JWT Cryptographic Signing Key (minimum 32 random characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-change-in-production

# JWT Token Expiration in minutes (e.g., 1440 = 24 hours, 60 = 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# JWT Refresh Token Expiration in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# Automatically seed default system roles, permissions, and demo personas on startup
AUTO_SEED_DATABASE=true


# ==============================================================================
# [C] CORS & NETWORKING
# Comma-separated list of allowed frontend origins for CORS headers.
# ==============================================================================

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://secureflow.duckdns.org

# Optional single canonical frontend URL (automatically merged into CORS allowed origins)
FRONTEND_URL=https://secureflow.duckdns.org


# ==============================================================================
# [D] DATABASE CONFIGURATION (PostgreSQL / SQLite)
# ==============================================================================

# PostgreSQL container credentials (used by docker-compose)
POSTGRES_USER=secureflow_user
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=secureflow_db
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432

# Full Async SQLAlchemy connection string (asyncpg driver)
# Docker Compose: postgresql+asyncpg://secureflow_user:your-secure-postgres-password@postgres:5432/secureflow_db
# Standalone local: sqlite+aiosqlite:///./secureflow.db
DATABASE_URL=postgresql+asyncpg://secureflow_user:your-secure-postgres-password@localhost:5432/secureflow_db


# ==============================================================================
# [E] REDIS & RATE LIMITING
# ==============================================================================

# Redis connection URI
# Docker Compose: redis://redis:6379/0
# Standalone local: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Enable sliding-window rate limiting via Redis
REDIS_RATE_LIMIT_ENABLED=true

# Rate limit budget per IP address (requests per minute)
RATE_LIMIT_REQUESTS_PER_MINUTE=120


# ==============================================================================
# [F] APACHE KAFKA & EVENT STREAMING
# ==============================================================================

# Enable Kafka integration (if false, backend falls back to in-memory event bus)
KAFKA_ENABLED=true

# Kafka bootstrap broker address
# Docker Compose: kafka:29092
# Local external: localhost:9092
KAFKA_BROKERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Consumer group and client IDs
KAFKA_CLIENT_ID=secureflow-backend
KAFKA_GROUP_ID=secureflow-consumers


# ==============================================================================
# [G] GOOGLE OAUTH 2.0 / OPENID CONNECT (SSO)
# Obtain credentials from: https://console.cloud.google.com/apis/credentials
# NEVER expose GOOGLE_CLIENT_SECRET to the frontend.
# ==============================================================================

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Must match the Authorized Redirect URI registered in Google Cloud Console exactly.
# Production:   https://secureflow.duckdns.org/auth/callback
# Local Docker: http://localhost:3000/auth/callback
# Local Vite:   http://localhost:5173/auth/callback
OAUTH_REDIRECT_URI=https://secureflow.duckdns.org/auth/callback


# ==============================================================================
# [H] CLOUD INFRASTRUCTURE (Optional — AWS / Terraform)
# ==============================================================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

