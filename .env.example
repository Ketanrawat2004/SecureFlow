# ==============================================================================
# SECUREFLOW - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real secrets to version control.
# .env is listed in .gitignore and will not be tracked by Git.
#
# For local Docker development:  copy to .env in the project root
# For Render deployment:         set these as Environment Variables in the dashboard
# ==============================================================================


# ==============================================================================
# [A] FRONTEND PUBLIC VARIABLES
# These are embedded at build time by Vite (must start with VITE_).
# They are visible to anyone who downloads the frontend bundle — never put secrets here.
# ==============================================================================

# Full URL of the deployed FastAPI backend (no trailing slash)
# Local dev:    leave empty or set to /api/v1  (Vite proxy handles it)
# Production:   https://secureflow-backend.onrender.com/api/v1
VITE_API_BASE_URL=

# App display title
VITE_APP_TITLE=SecureFlow


# ==============================================================================
# [B] BACKEND — CORE
# ==============================================================================

ENVIRONMENT=production
APP_NAME=SecureFlow
DEBUG=false

# Port (Render sets this automatically; leave 8000 for local Docker)
PORT=8000

# JWT secret — must be a long, random, unique string. Never share.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-min-32-chars

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ==============================================================================
# [C] BACKEND — CORS
# Comma-separated list of allowed frontend origins.
# Local Docker:   http://localhost:3000,http://localhost:5173
# Production:     https://secureflow.onrender.com
# ==============================================================================

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000


# ==============================================================================
# [D] BACKEND — DATABASE (PostgreSQL)
# Production: use Render PostgreSQL internal connection string
# ==============================================================================

# Full async SQLAlchemy connection string (asyncpg driver)
# Render internal: postgresql+asyncpg://user:pass@hostname/dbname
DATABASE_URL=postgresql+asyncpg://secureflow_user:secureflow_password@localhost:5432/secureflow_db

# Docker Compose uses these individual vars to build DATABASE_URL
POSTGRES_USER=secureflow_user
POSTGRES_PASSWORD=secureflow_password
POSTGRES_DB=secureflow_db


# ==============================================================================
# [E] BACKEND — REDIS
# Production: use Render Redis internal URL (rediss:// for TLS)
# ==============================================================================

REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120


# ==============================================================================
# [F] BACKEND — KAFKA (local Docker only)
# Kafka is NOT available on Render free tier.
# Set KAFKA_ENABLED=false in production — the app degrades gracefully.
# ==============================================================================

KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=secureflow-backend
KAFKA_GROUP_ID=secureflow-consumers


# ==============================================================================
# [G] GOOGLE OAUTH 2.0 / OPENID CONNECT  — SECRETS
# Get from: https://console.cloud.google.com/apis/credentials
# NEVER expose GOOGLE_CLIENT_SECRET to the frontend.
# ==============================================================================

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Must match the Authorized Redirect URI in Google Cloud Console exactly.
# Local Docker:   http://localhost:3000/auth/callback
# Production:     https://secureflow.onrender.com/auth/callback
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback


# ==============================================================================
# [H] AWS (only needed for Terraform/ECS deployment — not required for Render)
# ==============================================================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=
